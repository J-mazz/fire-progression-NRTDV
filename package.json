{
  "name": "wildfire-nrt-dv",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build": "bash build.sh",
    "build:native": "bash tools/build_native.sh",
    "build:pages": "bash tools/build_pages.sh",
    "build:wasm": "bash tools/build_wasm.sh",
    "deploy:pages": "npm run build:pages && wrangler pages deploy dist --project-name fire-progression-nrtdv --branch main",
    "dev": "npm run build && node tools/dev_server.js",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run_tests.js"
  },
  "dependencies": {
    "@tmcw/togeojson": "^7.1.2",
    "maplibre-gl": "^5.24.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.114.0"
  }
}
