# Copy to .env.local (git-ignored) and fill in. Only the pipeline tools read
# these; the frontend and the Pages build never see them.

# NASA FIRMS map key, for pulling VIIRS active-fire CSV exports.
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Copernicus Data Space identifiers, used when sourcing Sentinel-2 scenes
# outside the anonymous Element 84 STAC endpoint.
# https://dataspace.copernicus.eu/
COPERN_USER_ID=
COPERN_ACCT_ID=

# Hugging Face token with read access to facebook/sam2.1-hiera-tiny.
# Required by tools/run_hotspot_sam2.sh; see docs/development.md.
# https://huggingface.co/settings/tokens
HF_TOKEN=
