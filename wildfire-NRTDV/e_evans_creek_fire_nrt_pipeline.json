{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_automation_framework": {
    "pipeline_metadata": {
      "pipeline_id": "e_evans_creek_fire_nrt_automation",
      "target_incident": "East Evans Creek Fire",
      "coordinate_bounds": {
        "spatial_reference": "EPSG:4326",
        "bbox_min_lat": 42.45,
        "bbox_min_lon": -123.05,
        "bbox_max_lat": 42.65,
        "bbox_max_lon": -122.75
      },
      "update_frequency_seconds": 300
    },
    "orchestration_sequence": [
      {
        "step_id": 0,
        "step_name": "raster_data_ingestion",
        "agent_role": "spatial_data_retrieval_agent",
        "actions": [
          {
            "action_id": "fetch_sentinel_2_tiles",
            "provider": "Copernicus_SciHub_API",
            "authentication": {
              "auth_type": "oauth2_client_credentials",
              "client_id": "216e7e25-f851-444b-a22f-e701fdda6a90"
            },
            "query_parameters": {
              "product_type": "S2MSI2A",
              "cloud_cover_max_percentage": 20,
              "bands": ["B02", "B03", "B04", "B08", "B11", "B12"]
            },
            "output_sink": "/var/data/staging/raster/sentinel2/"
          },
          {
            "action_id": "fetch_terrain_dem",
            "provider": "USGS_3DEP_API",
            "query_parameters": {
              "resolution": "1/3_arc_second",
              "format": "GeoTIFF"
            },
            "output_sink": "/var/data/staging/raster/dem/"
          }
        ],
        "error_handling": {
          "on_failure": "retry_with_backoff",
          "max_retries": 3
        }
      },
      {
        "step_id": 1,
        "step_name": "vector_telemetry_ingestion",
        "agent_role": "telemetry_polling_agent",
        "actions": [
          {
            "action_id": "poll_nasa_firms",
            "provider": "NASA_FIRMS_VIIRS_API",
            "authentication": {
              "auth_type": "map_key",
              "token": "674ff39dd919675d567bce9fd7403fb1"
            },
            "query_parameters": {
              "instrument": "VIIRS",
              "output_format": "CSV"
            },
            "output_sink": "/var/data/staging/vector/firms/"
          },
          {
            "action_id": "fetch_nifc_perimeter",
            "provider": "NIFC_OpenData_KML",
            "query_parameters": {
              "layer": "Current_Perimeters",
              "format": "KML"
            },
            "output_sink": "/var/data/staging/vector/nifc/"
          }
        ],
        "error_handling": {
          "on_failure": "fallback_to_cached_state"
        }
      },
      {
        "step_id": 2,
        "step_name": "hardware_accelerated_ml_inference",
        "agent_role": "ml_inference_orchestrator",
        "execution_environment": {
          "compute_target": "CUDA_GPU_CLUSTER",
          "precision": "float16"
        },
        "actions": [
          {
            "action_id": "segment_burn_scar_and_smoke",
            "model_architecture": "SAM_2_Video_Image",
            "input_sources": {
              "image_path": "/var/data/staging/raster/sentinel2/latest_rgb.tif"
            },
            "inference_parameters": {
              "prompts": "multypoint_grid_active_hotspots",
              "mask_threshold": 0.5
            },
            "output_sink": "/var/data/inference/sam2/masks/"
          },
          {
            "action_id": "analyze_burn_severity_and_vegetation",
            "model_architecture": "NASA_IBM_Prithvi_100M",
            "input_sources": {
              "temporal_images": [
                "/var/data/staging/raster/sentinel2/pre_fire.tif",
                "/var/data/staging/raster/sentinel2/latest_bands.tif"
              ]
            },
            "inference_parameters": {
              "task": "burn_severity_segmentation",
              "normalized_burn_ratio_weight": 0.6
            },
            "output_sink": "/var/data/inference/prithvi/raster/"
          }
        ],
        "dependencies": [0, 1]
      },
      {
        "step_id": 3,
        "step_name": "geometry_extraction_and_serialization",
        "agent_role": "geospatial_optimization_agent",
        "actions": [
          {
            "action_id": "vectorize_sam2_masks",
            "tool": "gdal_polygonize",
            "input_source": "/var/data/inference/sam2/masks/",
            "simplification_tolerance_meters": 10.0,
            "output_format": "GeoJSON"
          },
          {
            "action_id": "reproject_to_web_mercator",
            "tool": "ogr2ogr",
            "target_crs": "EPSG:3857",
            "output_sink": "/var/data/distribution/vector_tiles/"
          }
        ],
        "dependencies": [2]
      },
      {
        "step_id": 4,
        "step_name": "stream_generation_and_wasm_dispatch",
        "agent_role": "wasm_data_feeder_agent",
        "actions": [
          {
            "action_id": "serialize_to_binary_flatbuffers",
            "schema_definition": "fire_scene_graph.fbs",
            "input_directory": "/var/data/distribution/",
            "output_sink": "/var/data/distribution/stream.bin"
          },
          {
            "action_id": "broadcast_via_websocket",
            "protocol": "WebSocket_Secure",
            "endpoint": "/ws/v1/fire_telemetry",
            "binary_type": "arraybuffer"
          }
        ],
        "dependencies": [3]
      }
    ],
    "client_wasm_heap_handshake": {
      "memory_allocation_directive": "explicit_c_string_pointers",
      "cpp_bindings": {
        "allocation_function": "ext_allocate_wasm_buffer",
        "processing_function": "ext_parse_scene_graph_stream",
        "deallocation_function": "ext_free_wasm_buffer"
      }
    }
  }
}
