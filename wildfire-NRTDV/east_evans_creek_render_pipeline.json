{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "wasm_cxx26_implementation_framework": {
    "engine_metadata": {
      "engine_name": "east_evans_creek_render_pipeline",
      "language_standard": "C++26",
      "compiler_toolchain": "Emscripten",
      "orchestrator_framework": "qwenclaw"
    },
    "compilation_directives": {
      "optimization_level": "-O3",
      "memory_model": {
        "initial_memory_mb": 256,
        "maximum_memory_mb": 1024,
        "allow_memory_growth": true,
        "export_allocators": ["_malloc", "_free"]
      },
      "exported_functions": [
        "_initialize_webgl_context",
        "_ingest_flatbuffer_stream",
        "_render_frame"
      ],
      "flags": [
        "-std=c++26",
        "-s USE_WEBGL2=1",
        "-s NO_DISABLE_EXCEPTION_CATCHING",
        "-s STRICT=1",
        "-D NDEBUG"
      ]
    },
    "memory_management_protocol": {
      "strategy": "raw_pointer_arithmetic",
      "string_handling": "null_terminated_c_strings",
      "data_types": {
        "strings": "const char*",
        "buffers": "unsigned char*",
        "geometries": "float*"
      },
      "buffer_allocation_cycle": [
        {
          "step": "client_requests_buffer",
          "action": "call_exported_malloc_from_javascript",
          "size_calculation": "flatbuffer_payload_byte_length",
          "type_casting": "reinterpret_cast<unsigned char*>"
        },
        {
          "step": "data_transfer",
          "action": "copy_websocket_arraybuffer_to_wasm_heap",
          "target_pointer": "unsigned char* payload_ptr"
        },
        {
          "step": "cxx26_processing",
          "action": "traverse_buffer_with_pointer_offsets",
          "safety_check": "verify_contiguous_memory_boundaries"
        },
        {
          "step": "memory_release",
          "action": "call_exported_free_post_render",
          "target_pointer": "void*"
        }
      ]
    },
    "rendering_pipeline_implementation": [
      {
        "phase": "initialization",
        "c_api_calls": [
          "emscripten_webgl_init_context_attributes",
          "emscripten_webgl_create_context",
          "emscripten_webgl_make_context_current"
        ]
      },
      {
        "phase": "shader_compilation",
        "description": "Compile vertex and fragment shaders using raw const char* pointers for source code parsing.",
        "gl_api_calls": [
          "glCreateShader",
          "glShaderSource",
          "glCompileShader",
          "glGetShaderiv"
        ]
      },
      {
        "phase": "geometry_buffer_updates",
        "description": "Map parsed FlatBuffer coordinate arrays directly to WebGL vertex buffer objects using contiguous float* pointer offsets.",
        "gl_api_calls": [
          "glBindBuffer",
          "glBufferData",
          "glVertexAttribPointer"
        ]
      },
      {
        "phase": "render_loop",
        "description": "Execute continuous draw calls triggered by the native browser animation frame synchronization.",
        "emscripten_api_calls": [
          "emscripten_set_main_loop_arg"
        ]
      }
    ]
  }
}
